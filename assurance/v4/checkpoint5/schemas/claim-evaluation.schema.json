{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "checkId", "observationId", "claimType", "assertion", "verdict", "confidence", "reasonCodes", "absenceMeans"],
  "properties": {
    "id": {"type": "string", "pattern": "^CL-CHK-[0-9]{2}$"},
    "checkId": {"$ref": "common-defs.schema.json#/$defs/checkId"},
    "observationId": {"type": "string", "pattern": "^OB-CHK-[0-9]{2}$"},
    "claimType": {"enum": ["configuration", "telemetry", "inventory", "documentary", "absence", "effectiveness"]},
    "assertion": {"type": "string", "minLength": 5},
    "verdict": {"enum": ["SUPPORTED", "REFUTED", "PARTIALLY_SUPPORTED", "UNRESOLVED", "INFORMATIONAL", "NOT_APPLICABLE"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "absenceMeans": {"enum": ["FAIL", "WARN", "UNKNOWN", "NOT_APPLICABLE", "NOT_OBSERVED"]}
  }
}
