{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["orderingRule", "NOW", "30d", "90d"],
  "properties": {
    "orderingRule": {"type": "string", "minLength": 5},
    "NOW": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "30d": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "90d": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["actionCardId", "riskId", "scenarioId", "priority", "priorityScore", "dueInDays", "owners", "controlIds"],
      "properties": {
        "actionCardId": {"type": "string", "pattern": "^ACI-R[0-9]{2}$"},
        "riskId": {"$ref": "common-defs.schema.json#/$defs/riskId"},
        "scenarioId": {"$ref": "common-defs.schema.json#/$defs/scenarioId"},
        "priority": {"$ref": "common-defs.schema.json#/$defs/priority"},
        "priorityScore": {"type": "integer", "minimum": 0, "maximum": 100},
        "dueInDays": {"enum": [0, 30, 90]},
        "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "controlIds": {"type": "array", "minItems": 1, "items": {"$ref": "common-defs.schema.json#/$defs/checkId"}, "uniqueItems": true}
      }
    }
  }
}
