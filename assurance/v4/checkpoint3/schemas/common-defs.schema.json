{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-defs.schema.json",
  "title": "Checkpoint 3 v4 common definitions",
  "$defs": {
    "checkId": {
      "type": "string",
      "pattern": "^CHK-(0[1-9]|[1-5][0-9]|6[0-4])$"
    },
    "riskId": {
      "type": "string",
      "pattern": "^R(0[1-9]|1[01])$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^AS(0[1-9]|1[01])$"
    },
    "boundaryId": {
      "type": "string",
      "pattern": "^SB0[1-8]$"
    },
    "securityScope": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "Global"
      ]
    },
    "defenseFunction": {
      "enum": [
        "Prevent",
        "Detect",
        "Respond",
        "Recover"
      ]
    },
    "stage": {
      "enum": [
        "IDENTITY",
        "MANAGEMENT",
        "HOST",
        "DEFENSE"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimType",
        "evidenceRequired",
        "absenceMeans",
        "evaluationRule"
      ],
      "properties": {
        "claimType": {
          "enum": [
            "configuration",
            "telemetry",
            "inventory",
            "documentary",
            "absence",
            "effectiveness"
          ]
        },
        "evidenceRequired": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "absenceMeans": {
          "enum": [
            "FAIL",
            "WARN",
            "UNKNOWN",
            "NOT_APPLICABLE",
            "NOT_OBSERVED"
          ]
        },
        "evaluationRule": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
