{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-assessment.schema.json",
  "title": "Control Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "checkId",
    "objective",
    "assertion",
    "statusModel",
    "securityModelStage",
    "securityScopes",
    "claim",
    "mappings",
    "securityBoundaryIds",
    "defenseFunctions",
    "mappingConfidence",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CA-(0[1-9]|[1-5][0-9]|6[0-4])$"
    },
    "checkId": {
      "$ref": "common-defs.schema.json#/$defs/checkId"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "assertion": {
      "type": "string",
      "minLength": 5
    },
    "statusModel": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string"
      }
    },
    "securityModelStage": {
      "$ref": "common-defs.schema.json#/$defs/stage"
    },
    "securityScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/securityScope"
      }
    },
    "claim": {
      "$ref": "common-defs.schema.json#/$defs/claim"
    },
    "mappings": {
      "type": "object"
    },
    "securityBoundaryIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/boundaryId"
      }
    },
    "defenseFunctions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/defenseFunction"
      }
    },
    "mappingConfidence": {
      "$ref": "common-defs.schema.json#/$defs/confidence"
    },
    "evidence": {
      "type": "object"
    }
  }
}
