{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defense-coverage.schema.json",
  "title": "Defense Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkId",
    "scenarioIds",
    "riskIds",
    "coverage",
    "rationale",
    "mappingConfidence"
  ],
  "properties": {
    "checkId": {
      "$ref": "common-defs.schema.json#/$defs/checkId"
    },
    "scenarioIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/scenarioId"
      }
    },
    "riskIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-defs.schema.json#/$defs/riskId"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Prevent",
        "Detect",
        "Respond",
        "Recover"
      ],
      "properties": {
        "Prevent": {
          "type": "boolean"
        },
        "Detect": {
          "type": "boolean"
        },
        "Respond": {
          "type": "boolean"
        },
        "Recover": {
          "type": "boolean"
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 20
    },
    "mappingConfidence": {
      "$ref": "common-defs.schema.json#/$defs/confidence"
    }
  }
}
