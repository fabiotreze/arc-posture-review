{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabiotreze.github.io/arc-posture-review/schemas/v4/action-card.schema.json",
  "title": "APR v4 Action Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cardId",
    "title",
    "priority",
    "workflowStatus",
    "checkIds"
  ],
  "properties": {
    "cardId": {
      "type": "string",
      "pattern": "^AC[0-9]{2}(-[A-Za-z0-9._-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "DECISION_REQUIRED", "ASSURANCE_REQUIRED"]
    },
    "workflowStatus": {
      "enum": [
        "OPEN",
        "PLANNED",
        "IMPLEMENTED",
        "VERIFICATION_PENDING",
        "VERIFIED",
        "CLOSED",
        "BLOCKED",
        "RISK_ACCEPTED",
        "EXCEPTION_GRANTED"
      ]
    },
    "checkIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CHK-[0-9]{2}$"
      }
    },
    "riskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^R[0-9]{2}"
      }
    },
    "effectiveTier": {
      "enum": ["T0", "T1", "T2", "GLOBAL", "UNKNOWN"]
    },
    "roadmapLane": {
      "enum": ["NOW", "DAYS_30", "DAYS_90", "BACKLOG", "DECISION_REQUIRED", "ASSURANCE_REQUIRED"]
    }
  }
}
